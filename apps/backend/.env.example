DATABASE_URL="postgresql://root:password123@localhost:5432/tribunal"
JWT_SECRET="chore-tribunal-dev-access-secret"
JWT_ACCESS_EXPIRES_IN_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
PORT=3000
REDIS_URL="redis://localhost:6379"

# Supported presets: aliyun | deepseek | kimi | zhipu | custom
LLM_PROVIDER="aliyun"

# Generic override. If all 3 are set, they take precedence over provider presets.
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""

# Provider-specific keys
DASHSCOPE_API_KEY=""
DEEPSEEK_API_KEY=""
MOONSHOT_API_KEY=""
ZAI_API_KEY=""

# Recommended defaults by provider:
# aliyun   -> https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen3.6-plus
# deepseek -> https://api.deepseek.com + deepseek-v4-flash
# kimi     -> https://api.moonshot.cn/v1 + kimi-k2.6
# zhipu    -> https://open.bigmodel.cn/api/paas/v4 + glm-5.1

LLM_TIMEOUT_MS=12000
LLM_MAX_RETRIES=2
